{
  "name": "xadrez",
  "version": "0.1.0",
  "description": "Xadrez online em salas, sem cadastro: cria a sala, manda o link, cada pessoa entra com um apelido.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "node test/e2e/run.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "chessground": "9.2.1",
    "stockfish": "19.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
